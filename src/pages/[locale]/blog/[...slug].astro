---
import { getCollection, render } from 'astro:content';
import { ArrowLeft, CalendarDays } from 'lucide-astro';
import Giscus from '../../../components/Giscus.astro';
import PostCard from '../../../components/PostCard.astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { entriesForTranslation, getLocaleFromEntry, getSlug, isPublished, postsForLocale, relatedPosts } from '../../../lib/content';
import { formatDate, getUi, isLocale, localeMeta, locales, localizedPath } from '../../../lib/i18n';

export async function getStaticPaths() {
  const entries = await getCollection('blog');
  return entries.filter(isPublished).map((entry) => ({
    params: { locale: getLocaleFromEntry(entry), slug: getSlug(entry) },
    props: { entry, entries },
  }));
}

const rawLocale = Astro.params.locale;
if (!isLocale(rawLocale)) throw new Error(`Unsupported locale: ${rawLocale}`);
const locale = rawLocale;
const { entry, entries } = Astro.props;
const copy = getUi(locale);
const { Content, headings } = await render(entry);
const posts = postsForLocale(entries, locale);
const currentIndex = posts.findIndex((item) => item.id === entry.id);
const previous = currentIndex > 0 ? posts[currentIndex - 1] : undefined;
const next = currentIndex >= 0 ? posts[currentIndex + 1] : undefined;
const related = relatedPosts(entries, entry, locale);
const translations = entriesForTranslation(entries, entry.data.translationId);
const translationHref = (target: typeof locale) => {
  const translated = translations.find((item) => getLocaleFromEntry(item) === target);
  return translated ? `/${target}/blog/${getSlug(translated)}/` : localizedPath(target, 'blog');
};
---

<SiteLayout locale={locale} title={entry.data.title} description={entry.data.description}>
  <div class="container">
    <header class="article-header">
      <a class="article-back" href={localizedPath(locale, 'blog')}><ArrowLeft size={15} strokeWidth={1.8} aria-hidden="true" /> {copy.article.back}</a>
      <p class="eyebrow">{entry.data.tags[0] || copy.blog.title}</p>
      <h1 class="article-title">{entry.data.title}</h1>
      <p class="article-description">{entry.data.description}</p>
      <div class="post-meta">
        <span><CalendarDays size={13} strokeWidth={1.8} aria-hidden="true" /> {formatDate(entry.data.pubDate, locale)}</span>
        <span class="meta-dot">{localeMeta[locale].label}</span>
        {entry.data.updatedDate && <span class="meta-dot">{copy.article.updated} {formatDate(entry.data.updatedDate, locale)}</span>}
      </div>
      <div class="language-rail" aria-label={copy.common.chooseLanguage}>
        {locales.map((target) => <a class:list={['language-chip', { active: target === locale }]} href={translationHref(target)} lang={localeMeta[target].htmlLang}>{localeMeta[target].label}</a>)}
      </div>
    </header>

    <div class="article-shell">
      <article class="prose">
        <Content />

        <footer class="article-footer">
          <h2 class="comments-heading">{copy.article.comments}</h2>
          <Giscus locale={locale} translationId={entry.data.translationId} />
        </footer>
      </article>

      {headings.filter((heading) => heading.depth <= 3).length > 0 && (
        <aside class="article-toc" aria-label="Table of contents">
          <p>{copy.article.related}</p>
          {headings.filter((heading) => heading.depth <= 3).map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}
        </aside>
      )}
    </div>

    {(previous || next || related.length > 0) && (
      <section class="related-section" aria-labelledby="related-heading">
        <div class="section-heading">
          <h2 class="section-title" id="related-heading">{copy.article.related}</h2>
          {next && <a class="text-link" href={`/${locale}/blog/${getSlug(next)}/`}>{copy.common.readArticle}</a>}
        </div>
        {related.length > 0 && <div class="post-list">{related.map((item) => <PostCard entry={item} locale={locale} />)}</div>}
      </section>
    )}
  </div>
</SiteLayout>
