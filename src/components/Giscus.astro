---
import type { Locale } from '../lib/i18n';
import { getUi, localeMeta } from '../lib/i18n';

interface Props {
  locale: Locale;
  translationId: string;
}

const { locale, translationId } = Astro.props;
const copy = getUi(locale);
const repo = import.meta.env.PUBLIC_GISCUS_REPO || 'yibenhaimo/personal-blog-comments';
const repoId = import.meta.env.PUBLIC_GISCUS_REPO_ID || '';
const category = import.meta.env.PUBLIC_GISCUS_CATEGORY || 'General';
const categoryId = import.meta.env.PUBLIC_GISCUS_CATEGORY_ID || '';
const ready = Boolean(repoId && categoryId);
const config = {
  repo,
  'repo-id': repoId,
  category,
  'category-id': categoryId,
  mapping: 'specific',
  term: `blog:${translationId}`,
  'reactions-enabled': '1',
  'emit-metadata': '0',
  'input-position': 'top',
  lang: localeMeta[locale].giscusLang,
};
---

<div class="giscus-shell" data-giscus-config={ready ? JSON.stringify(config) : undefined}>
  {!ready && <p class="giscus-placeholder">{copy.article.setup}</p>}
</div>

{ready && (
  <script is:inline>
    const root = document.querySelector('[data-giscus-config]');
    if (root && root.dataset.giscusBound !== 'true') {
      root.dataset.giscusBound = 'true';
      const config = JSON.parse(root.dataset.giscusConfig || '{}');
      const client = document.createElement('script');
      client.src = 'https://giscus.app/client.js';
      client.async = true;
      client.crossOrigin = 'anonymous';
      Object.entries(config).forEach(([key, value]) => client.setAttribute(`data-${key}`, String(value)));
      client.setAttribute('data-theme', document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');
      root.appendChild(client);

      const syncTheme = (theme) => {
        const frame = document.querySelector('iframe.giscus-frame');
        frame?.contentWindow?.postMessage({ giscus: { setConfig: { theme } } }, 'https://giscus.app');
      };

      window.addEventListener('themechange', (event) => syncTheme(event.detail?.theme === 'dark' ? 'dark' : 'light'));
      const observer = new MutationObserver(() => syncTheme(document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light'));
      observer.observe(root, { childList: true, subtree: true });
    }
  </script>
)}
